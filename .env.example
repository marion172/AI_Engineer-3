# ==========================================
# Configuración del Proveedor LLM y Embeddings
# ==========================================

# Clave de API (OpenAI u OpenRouter u otro compatible)
OPENAI_API_KEY=tu_api_key_aqui

# URL base de la API (opcional, para OpenRouter o local endpoints)
# OpenAI estándar: https://api.openai.com/v1
# OpenRouter: https://openrouter.ai/api/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Modelo generativo para el LLM
# Ejemplos: gpt-4o-mini, gpt-3.5-turbo, etc.
OPENAI_MODEL=gpt-4o-mini

# Modelo de Embeddings (Debe ser consistente en ingesta y consulta)
# Ejemplos: text-embedding-3-small, text-embedding-ada-002
EMBEDDING_MODEL=text-embedding-3-small

# ==========================================
# Configuración de ChromaDB y Chunking RAG
# ==========================================

# Ruta de almacenamiento persistente local para ChromaDB
CHROMA_PERSIST_DIRECTORY=./vectorstore

# Nombre de la colección en ChromaDB
CHROMA_COLLECTION_NAME=novacore_knowledge_base

# Parámetros de chunking estratégico (tokens)
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Cantidad de fragmentos recuperados para el contexto (top_k recomendado: 3 a 5)
TOP_K=4

